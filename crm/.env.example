# Copia este archivo a .env.local.

# Sin DATABASE_URL, la app usa PGlite: PostgreSQL embebido que guarda los datos en .data/pglite.
# Con DATABASE_URL, usa un PostgreSQL normal (Docker, Neon, AWS...). El SSL va en la URL (sslmode=require).
# DATABASE_URL=postgres://usuario:clave@localhost:5432/rea_crm

# Secreto para firmar sesiones. Genera uno propio, por ejemplo: openssl rand -base64 32
AUTH_SECRET=cambia-este-valor

# URL pública de la app.
BETTER_AUTH_URL=http://localhost:3000
