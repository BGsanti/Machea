# Copia este archivo a .env.local.

# Sin DATABASE_URL, la app usa PGlite: PostgreSQL embebido que guarda los datos en .data/pglite.
# Con DATABASE_URL, usa un PostgreSQL normal (Docker, Neon, AWS...). El SSL va en la URL (sslmode=require).
# DATABASE_URL=postgres://usuario:clave@localhost:5432/rea_crm

# Inicio de sesión:
# - local (por defecto): usuarios propios del CRM con Better Auth.
# - machea: la sesión del login de Machea (cookie machea_sesion, esquema acceso de la misma base).
#   Es el único modo permitido en Vercel. Ver ../design/crm/PUESTA_EN_MARCHA.md.
# AUTH_MODO=local
# MACHEA_URL=https://www.machea.co

# Solo modo local. Secreto para firmar sesiones. Genera uno propio, por ejemplo: openssl rand -base64 32
AUTH_SECRET=cambia-este-valor

# Solo modo local. URL pública de la app.
BETTER_AUTH_URL=http://localhost:3000

# En producción las migraciones las aplica una persona antes del despliegue: false.
# CRM_MIGRAR_AL_ARRANCAR=false

# Para servir el CRM en www.machea.co/crm (se fijan al compilar).
# CRM_BASE_PATH=/crm
# CRM_ORIGENES=www.machea.co

# Con AUTH_MODO=machea, los datos de ejemplo están apagados salvo con esto (cuenta de demostración).
# CRM_PERMITIR_EJEMPLOS=1
